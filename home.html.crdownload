<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<script>(function(){try{if(localStorage.getItem('oc-theme')==='dark')document.documentElement.setAttribute('data-theme','dark');}catch(e){}})();</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OPUSCLAM.COM — Classic Speciality</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" type="image/png" href="/icon-192.png">
<meta name="theme-color" content="#0a0d24">
<link rel="apple-touch-icon" href="/icon-192.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="OPUSCLAM">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
<style>
  :root{
    --ink:#0E1230;          /* deep navy ground */
    --ink-2:#161B44;
    --violet:#5A4A7A;       /* plum */
    --violet-2:#7C63B0;
    --violet-3:#9C7FD6;
    --gold:#C9A94E;         /* warm accent */
    --orange:#EC7A1C;       /* orange accent */
    --paper:#ffffff;
    --paper-2:#fefcf8;
    --paper-3:#f7f2ea;
    --line:#efeae0;
    --line-2:#e4ded2;
    --text:#20223a;
    --text-2:#5a5b74;
    --text-3:#8f90a6;
    --link-idle:#a9aab8;
    --link-hover:#2b2d42;
    --hero-grad:linear-gradient(115deg,#0E1230 0%,#241a44 42%,#4a2f6e 72%,#6b3f86 100%);
    --band-grad:#000000;
    --serif:"Pretendard",-apple-system,system-ui,sans-serif;
    --display:"Pretendard",-apple-system,system-ui,sans-serif;
    --sans:"Pretendard",-apple-system,system-ui,sans-serif;
    --wrap:1180px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:var(--sans);color:var(--text);background:#ffffff;font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  img{max-width:100%;display:block}
  .wrap{max-width:var(--wrap);margin:0 auto;padding:0 20px}
  .en{font-family:var(--serif);letter-spacing:.02em}
  .disp{font-family:var(--display)}

  /* ---------- placeholders ---------- */
  /* 악보·자료 목록 — 여섯 줄이 되면서 세로로 길어져서 줄 간격을 좁혔습니다.
     style.css 는 건드리지 않고 이 페이지에서만 적용합니다. */
  #scores-list li{padding:7px 0;gap:8px}
  #scores-list li .icon{width:24px;height:24px;border-radius:5px}
  #scores-list li .icon svg{width:13px;height:13px}
  #scores-list .dl-no{flex:0 0 auto;width:20px;font-family:var(--display);font-size:11px;
    font-weight:700;color:var(--text-3);letter-spacing:.02em;text-align:right}
  /* 날짜 — 오른쪽 끝에 */
  #scores-list li .dt{flex:0 0 auto;font-size:11px;color:var(--text-3);white-space:nowrap;
    padding-left:10px;font-variant-numeric:tabular-nums}

  /* 입시요강 「해외」 버튼과 「입시커뮤니티」 버튼
     style.css 를 건드리지 않고 이 페이지에서만 씁니다

     해외 버튼은 인라인 스타일을 쓰지 않습니다.
     인라인으로 글자색을 정하면 마우스를 올렸을 때도 그 색이 유지되어
     보라 배경에 보라 글자가 되어 글자가 보이지 않습니다.
     클래스로 지정하면 :hover 규칙이 정상으로 이깁니다. */
  .grid-region a.rg-abroad{border-color:rgba(124,99,176,.55);color:var(--violet-2);font-weight:700}

  /* 로고에 쓰인 색을 그대로 옮겼습니다 — 남색에서 자주로 흐릅니다 */
  .exam-comm{display:flex;align-items:center;justify-content:space-between;gap:10px;
    margin-top:8px;padding:13px 15px;border-radius:6px;text-decoration:none;
    background:linear-gradient(100deg,#3a4a8f 0%,#5b4f9c 45%,#a45cac 100%);
    color:#fff;transition:.18s;box-shadow:0 2px 10px rgba(58,74,143,.28)}
  .exam-comm:hover{filter:brightness(1.1);box-shadow:0 4px 16px rgba(58,74,143,.36)}
  .exam-comm span{font-size:13.5px;font-weight:800;letter-spacing:-.01em}
  .exam-comm em{font-style:normal;font-size:11.5px;opacity:.92;white-space:nowrap}
  @media(max-width:420px){ .exam-comm em{display:none} }

  .card-link{position:absolute;inset:0;z-index:6;border-radius:inherit;text-indent:-9999px;overflow:hidden}
  /* 사진이 없는 자리 — 어두운 바탕에 오퍼스클램 로고를 옅게 얹습니다.
     예전에는 사선 무늬에 「IMAGE」 라는 글자를 보여 주었습니다.

     로고를 배경 그림으로 넣습니다. 원본이 남색·자주색이라 어두운 바탕에서
     잘 보이지 않으므로, 흰색으로 바꾼 것을 덧그림(::after)으로 얹었습니다. */
  .ph{background:linear-gradient(135deg,#262038 0%,#332b4d 100%);
      position:relative;overflow:hidden}
  .ph::after{content:"";position:absolute;inset:0;
      background-image:url("/assets/logo.png");
      background-repeat:no-repeat;background-position:center;
      background-size:min(62%,180px) auto;
      opacity:.4;filter:brightness(0) invert(1)}
  /* 어두운 화면에서도 같은 모습입니다 */
  .ph.dark{background:linear-gradient(135deg,#1e1930 0%,#2b2442 100%)}
  .ph.dark::after{opacity:.34}

  /* ---------- utility top bar ---------- */
  .util{background:#0a0d24;color:#a9abc7;font-size:9px;letter-spacing:.01em;border-bottom:1px solid rgba(255,255,255,.05)}
  .util .wrap{display:flex;align-items:center;justify-content:space-between;height:34px}
  .util .left a{margin-right:18px;color:rgba(255,255,255,.34);font-family:var(--serif);letter-spacing:.05em;font-size:8px;font-weight:600;transition:color .2s ease}
  .util .right a{color:rgba(255,255,255,.34);letter-spacing:.04em;font-size:8px;font-weight:600;transition:color .2s ease}
  .util a:hover{color:#fff}
  .m-community{display:none}
  @media(max-width:880px){
    .m-community{display:block;margin:10px 24px 4px;padding-top:16px;border-top:1px solid rgba(255,255,255,.08);color:rgba(255,255,255,.6);font-family:var(--serif);letter-spacing:.12em;font-size:11px;font-weight:600;transition:color .2s ease}
    .m-community:active{color:#fff}
  }
  @media(max-width:880px){
    .util .left{white-space:nowrap;min-width:0}
    .util .left a{margin-right:14px}
    .util .left a:last-child{display:none}
    .util .right{white-space:nowrap;flex:0 0 auto;padding-left:14px}
  }

  /* ---------- header ---------- */
  .site-header{position:fixed;top:0;left:0;right:0;z-index:60;transition:background .35s ease}
  .util{transition:background .35s ease}
  header.masthead{background:var(--paper);border-bottom:1px solid var(--line);position:relative;transition:background .35s ease,border-color .35s ease}
  .link-txt{font-size:12.5px;color:var(--text-2)}
  .mast-row{max-width:1320px;display:flex;align-items:center;justify-content:space-between;height:78px;gap:24px}
  .brand{display:flex;align-items:center;gap:10px;flex:0 0 auto}
  .logo-img{height:34px;width:auto;display:block;transition:filter .35s ease}
  .site-header:not(.solid) .logo-img{filter:brightness(0) invert(1)}
  @media(max-width:880px){.logo-img{height:29px}}
  .brand .logo{font-family:var(--display);font-weight:800;font-size:27px;letter-spacing:.04em;color:var(--ink)}
  .brand .logo b{color:var(--violet-2)}
  .brand .tag{font-size:11px;letter-spacing:.34em;color:var(--text-3);text-transform:uppercase}
  @media(max-width:1240px){.brand .tag{display:none}}
  nav.main{display:flex;gap:40px;flex-wrap:nowrap}
  .nav-item{position:static;display:flex;align-items:center}
  nav.main>.nav-item>a{font-weight:600;font-size:15px;color:#9a9baa;position:relative;padding:27px 0;letter-spacing:-.01em;white-space:nowrap;transition:color .2s ease}
  nav.main>.nav-item>a.active,nav.main>.nav-item:hover>a{color:#363845}
  nav.main>.nav-item>a.active::after,nav.main>.nav-item:hover>a::after{content:"";position:absolute;left:0;right:0;bottom:24px;height:2px;background:var(--orange)}
  /* horizontal submenu bar */
  .dropdown{position:absolute;top:100%;left:0;right:0;width:100%;
    background:rgba(234,234,238,.88);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border-top:1px solid var(--line);border-bottom:1px solid #d6d6dc;box-shadow:0 16px 32px -18px rgba(30,20,60,.28);
    opacity:0;visibility:hidden;pointer-events:none;transition:opacity .22s ease,visibility .22s ease;z-index:65}
  .nav-item:hover .dropdown{opacity:1;visibility:visible;pointer-events:auto}
  .dropdown-inner{max-width:var(--wrap);margin:0 auto;padding:12px 20px;display:flex;flex-wrap:wrap;justify-content:center;align-items:center}
  /* DATABASE 메뉴만 왼쪽 정렬 (형태·다른 메뉴는 그대로) */
  .nav-item--db .dropdown-inner{justify-content:flex-start}
  .dropdown a{position:relative;font-size:13px;color:#9a9baa;padding:5px 18px;white-space:nowrap;letter-spacing:-.01em;transition:color .15s}
  .dropdown a:not(:last-child)::after{content:"";position:absolute;right:0;top:50%;transform:translateY(-50%);width:1px;height:11px;background:var(--line-2)}
  .dropdown a:hover{color:#363845}
  .mast-tools{display:flex;align-items:center;gap:12px;flex:0 0 auto}
  .mast-tools a{white-space:nowrap}
  .mast-tools .search{width:34px;height:34px;border:1px solid var(--line-2);border-radius:50%;display:grid;place-items:center;color:var(--text-2);transition:.2s}
  .mast-tools .search:hover{background:var(--violet-2);color:#fff;border-color:var(--violet-2)}
  .mast-tools .school{background:var(--orange);color:#fff;font-weight:700;font-size:12px;padding:8px 14px;border-radius:20px}
  .burger{display:none;flex-direction:column;gap:4px;width:40px;height:40px;border:1px solid var(--line-2);border-radius:8px;align-items:center;justify-content:center;cursor:pointer;background:none;padding:0}
  .burger span{width:18px;height:2px;background:var(--ink);transition:transform .25s ease,opacity .2s ease}
  .burger.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
  .burger.open span:nth-child(2){opacity:0}
  .burger.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}

  /* full menu button */
  .fullmenu-btn{width:42px;height:42px;border-radius:10px;background:var(--violet-2);border:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;cursor:pointer;padding:0;transition:background .2s;flex:0 0 auto}
  .fullmenu-btn span{width:18px;height:2px;background:#fff;border-radius:2px;transition:.2s}
  .fullmenu-btn:hover{background:var(--violet)}
  .fullmenu-btn:hover span:nth-child(1){width:20px}
  .fullmenu-btn:hover span:nth-child(3){width:14px}

  /* full menu — deep navy fullscreen */
  .fullmenu{position:fixed;inset:0;z-index:120;visibility:hidden;opacity:0;transition:opacity .35s ease,visibility .35s ease}
  .fullmenu.open{visibility:visible;opacity:1}
  .fullmenu-panel{position:absolute;inset:0;background:linear-gradient(120deg,#070812 0%,#120c22 44%,#221534 72%,#2e1d3e 100%);overflow:hidden;transform:scale(1.03);transition:transform .42s cubic-bezier(.22,1,.36,1);display:flex;flex-direction:column}
  .fullmenu.open .fullmenu-panel{transform:none}
  .fullmenu-panel::before{content:"";position:absolute;top:-18%;right:-8%;width:620px;height:620px;background:radial-gradient(circle,rgba(156,127,214,.28),transparent 70%);pointer-events:none;z-index:0}
  .fullmenu-panel::after{content:"";position:absolute;bottom:-20%;left:-6%;width:520px;height:520px;background:radial-gradient(circle,rgba(201,169,78,.14),transparent 70%);pointer-events:none;z-index:0}
  .fullmenu-head{position:relative;z-index:1;width:100%;display:flex;align-items:center;justify-content:space-between;height:90px;border-bottom:1px solid rgba(255,255,255,.13);flex:0 0 auto}
  .fullmenu-head .fm-logo{height:32px;width:auto;display:block;filter:brightness(0) invert(1)}
  .fullmenu-head .fm-logolink{display:inline-flex;align-items:center}
  .fullmenu-close{width:46px;height:46px;border-radius:12px;border:1px solid rgba(255,255,255,.28);background:rgba(255,255,255,.06);display:grid;place-items:center;cursor:pointer;color:#fff;transition:background .2s,border-color .2s,transform .3s}
  .fullmenu-close:hover{background:var(--orange);border-color:var(--orange);transform:rotate(90deg)}
  .fullmenu .wrap{max-width:1560px;padding:0 48px}
  .fullmenu-body{position:relative;z-index:1;flex:1 1 auto;display:flex;align-items:center;padding:44px 0 64px;overflow-y:auto;min-height:0}
  .fullmenu-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:44px;width:100%}
  .fm-col .fm-num{font-family:var(--display);font-size:13px;font-weight:700;letter-spacing:.14em;color:var(--orange);margin-bottom:12px}
  .fm-col h4{font-weight:800;font-size:20px;letter-spacing:-.01em;color:#fff;padding-bottom:18px;margin-bottom:18px;border-bottom:1px solid rgba(255,255,255,.2)}
  .fm-col a{display:block;font-size:15px;color:rgba(255,255,255,.6);padding:10px 0;transition:color .18s ease,transform .18s ease;position:relative;border-bottom:1px solid rgba(255,255,255,.07)}
  .fm-col a:last-child{border-bottom:0}
  .fm-col a:hover{color:#fff;transform:translateX(8px)}
  .fm-col a:hover::before{content:"";position:absolute;left:-13px;top:50%;transform:translateY(-50%);width:5px;height:5px;border-radius:50%;background:var(--orange)}
  @media(max-width:980px){.fullmenu-grid{grid-template-columns:repeat(3,1fr);row-gap:42px}.fullmenu-body{align-items:flex-start}}
  @media(max-width:600px){.fullmenu-grid{grid-template-columns:repeat(2,1fr);gap:22px}.fullmenu-head .fm-logo{height:26px}}
  .m-actions{display:none}
  .nav-close{display:none}
  .nav-overlay{position:fixed;inset:0;background:rgba(10,13,36,.5);opacity:0;visibility:hidden;transition:opacity .3s ease,visibility .3s ease;z-index:85}
  .nav-overlay.open{opacity:1;visibility:visible}

  /* sub nav */
  .subnav{background:var(--paper);border-bottom:1px solid var(--line);transition:background .35s ease,border-color .35s ease}
  .subnav .wrap{display:flex;flex-wrap:wrap;gap:0;justify-content:center;padding:11px 20px}
  .subnav a{font-size:12.5px;color:var(--text-2);padding:2px 16px;position:relative;letter-spacing:-.01em}
  .subnav a:not(:last-child)::after{content:"";position:absolute;right:0;top:50%;transform:translateY(-50%);width:1px;height:11px;background:var(--line-2)}
  .subnav a:hover{color:var(--violet-2)}

  /* ----- transparent overlay state (over hero) ----- */
  .site-header:not(.solid) .util,
  .site-header:not(.solid) header.masthead,
  .site-header:not(.solid) .subnav{background:transparent;border-color:transparent}
  .site-header:not(.solid) .util{border-bottom-color:rgba(255,255,255,.09)}
  .site-header:not(.solid) .brand .logo{color:#fff}
  .site-header:not(.solid) .brand .logo b{color:var(--violet-3)}
  .site-header:not(.solid) .brand .tag{color:rgba(255,255,255,.55)}
  .site-header:not(.solid) nav.main>.nav-item>a{color:rgba(255,255,255,.55)}
  .site-header:not(.solid) nav.main>.nav-item>a.active,
  .site-header:not(.solid) nav.main>.nav-item:hover>a{color:#fff}
  .site-header:not(.solid) nav.main>.nav-item>a.active::after{background:var(--orange)}
  .site-header:not(.solid) .link-txt{color:rgba(255,255,255,.82)}
  .site-header:not(.solid) .link-txt:hover{color:#fff}
  .site-header:not(.solid) .search{border-color:rgba(255,255,255,.45);color:#fff}
  .site-header:not(.solid) .search:hover{background:var(--gold);border-color:var(--gold);color:#3a2c05}
  .site-header:not(.solid) .subnav a{color:rgba(255,255,255,.72)}
  .site-header:not(.solid) .subnav a:hover{color:#fff}
  .site-header:not(.solid) .subnav a:not(:last-child)::after{background:rgba(255,255,255,.22)}
  .site-header:not(.solid) .burger{border-color:rgba(255,255,255,.4)}
  .site-header:not(.solid) .burger span{background:#fff}
  /* solid state keeps the original (default) colors defined above */

  /* ---------- hero ---------- */
  .hero{background:linear-gradient(115deg,#080a1a 0%,#161029 42%,#2a1a42 72%,#3d2456 100%);color:#fff;position:relative;overflow:hidden}
  .hero::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,transparent 38%,rgba(14,18,48,.92) 100%)}
  .hero .wrap{position:relative;z-index:2;min-height:510px;display:grid;align-items:center;padding-top:128px;padding-bottom:48px}
  .hslide{grid-area:1/1;opacity:0;visibility:hidden;transform:translateY(14px);transition:opacity .6s ease,transform .6s ease}
  .h