{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Gg]ooglebot|Google-InspectionTool|Storebot-Google|[Bb]ingbot|[Yy]eti|[Dd]aumoa|[Nn]aver[Bb]ot|Slurp|[Dd]uck[Dd]uck[Bb]ot|[Bb]aiduspider|[Yy]andex|[Aa]pplebot|facebookexternalhit|[Tt]witterbot|[Ss]lackbot|[Ll]inked[Ii]n[Bb]ot|kakaotalk-scrap|[Tt]elegram[Bb]ot|[Dd]iscordbot|[Ww]hats[Aa]pp|[Ee]mbedly|[Pp]interest).*"
        }
      ],
      "destination": "/home.html"
    },
    {
      "source": "/index",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Gg]ooglebot|Google-InspectionTool|Storebot-Google|[Bb]ingbot|[Yy]eti|[Dd]aumoa|[Nn]aver[Bb]ot|Slurp|[Dd]uck[Dd]uck[Bb]ot|[Bb]aiduspider|[Yy]andex|[Aa]pplebot|facebookexternalhit|[Tt]witterbot|[Ss]lackbot|[Ll]inked[Ii]n[Bb]ot|kakaotalk-scrap|[Tt]elegram[Bb]ot|[Dd]iscordbot|[Ww]hats[Aa]pp|[Ee]mbedly|[Pp]interest).*"
        }
      ],
      "destination": "/home.html"
    },
    {
      "source": "/db/person-view.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Gg]ooglebot|Google-InspectionTool|Storebot-Google|[Bb]ingbot|[Yy]eti|[Dd]aumoa|[Nn]aver[Bb]ot|Slurp|[Dd]uck[Dd]uck[Bb]ot|[Bb]aiduspider|[Yy]andex|[Aa]pplebot|facebookexternalhit|[Tt]witterbot|[Ss]lackbot|[Ll]inked[Ii]n[Bb]ot|kakaotalk-scrap|[Tt]elegram[Bb]ot|[Dd]iscordbot|[Ww]hats[Aa]pp|[Ee]mbedly|[Pp]interest).*"
        }
      ],
      "destination": "/api/seo?kind=person"
    },
    {
      "source": "/db/work-view.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Gg]ooglebot|Google-InspectionTool|Storebot-Google|[Bb]ingbot|[Yy]eti|[Dd]aumoa|[Nn]aver[Bb]ot|Slurp|[Dd]uck[Dd]uck[Bb]ot|[Bb]aiduspider|[Yy]andex|[Aa]pplebot|facebookexternalhit|[Tt]witterbot|[Ss]lackbot|[Ll]inked[Ii]n[Bb]ot|kakaotalk-scrap|[Tt]elegram[Bb]ot|[Dd]iscordbot|[Ww]hats[Aa]pp|[Ee]mbedly|[Pp]interest).*"
        }
      ],
      "destination": "/api/seo?kind=work"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/partials/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/privacy",
      "destination": "/legal/privacy.html",
      "permanent": true
    },
    {
      "source": "/policy",
      "destination": "/legal/terms.html",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/legal/terms.html",
      "permanent": true
    },
    {
      "source": "/agreement",
      "destination": "/legal/terms.html",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "/account/login.html",
      "permanent": true
    },
    {
      "source": "/join",
      "destination": "/account/join.html",
      "permanent": true
    },
    {
      "source": "/member",
      "destination": "/account/join.html",
      "permanent": true
    },
    {
      "source": "/findPass",
      "destination": "/account/find-pw.html",
      "permanent": true
    },
    {
      "source": "/findpass",
      "destination": "/account/find-pw.html",
      "permanent": true
    },
    {
      "source": "/findId",
      "destination": "/account/find-id.html",
      "permanent": true
    },
    {
      "source": "/findid",
      "destination": "/account/find-id.html",
      "permanent": true
    },
    {
      "source": "/mypage",
      "destination": "/account/interests.html",
      "permanent": true
    }
  ]
}
